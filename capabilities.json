{
    "dataRoles": [
        {
            "displayName": "门店",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "销售额",
            "name": "measure",
            "kind": "Measure"
        },
        {
            "displayName": "工具提示",
            "description": "可添加多个辅助字段或度量",
            "name": "tooltips",
            "kind": "GroupingOrMeasure"
        }
    ],
    "objects": {
        "line": {
            "displayName": "曲线",
            "properties": {
                "color": {
                    "displayName": "颜色",
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "width": {
                    "displayName": "线宽",
                    "type": { "numeric": true }
                }
            }
        },
        "axes": {
            "displayName": "坐标轴",
            "properties": {
                "showGridlines": {
                    "displayName": "显示网格线",
                    "type": { "bool": true }
                },
                "fontSize": {
                    "displayName": "字号",
                    "type": { "formatting": { "fontSize": true } }
                }
            }
        },
        "dataLabels": {
            "displayName": "数据标签",
            "properties": {
                "show": {
                    "displayName": "显示",
                    "type": { "bool": true }
                },
                "count": {
                    "displayName": "标签数量",
                    "type": { "numeric": true }
                },
                "fontSize": {
                    "displayName": "字号",
                    "type": { "formatting": { "fontSize": true } }
                }
            }
        },
        "referenceLine": {
            "displayName": "占比参考线",
            "properties": {
                "show": {
                    "displayName": "显示",
                    "type": { "bool": true }
                },
                "value": {
                    "displayName": "累计占比",
                    "type": { "numeric": true }
                },
                "color": {
                    "displayName": "颜色",
                    "type": { "fill": { "solid": { "color": true } } }
                }
            }
        },
        "countReferenceLine": {
            "displayName": "数量参考线",
            "properties": {
                "show": {
                    "displayName": "显示",
                    "type": { "bool": true }
                },
                "value": {
                    "displayName": "门店数量",
                    "type": { "numeric": true }
                },
                "color": {
                    "displayName": "颜色",
                    "type": { "fill": { "solid": { "color": true } } }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "category" } },
                        { "for": { "in": "measure" } },
                        { "for": { "in": "tooltips" } }
                    ],
                    "dataReductionAlgorithm": {
                        "window": { "count": 30000 }
                    }
                }
            }
        }
    ],
    "tooltips": {
        "supportedTypes": { "default": true, "canvas": true },
        "roles": ["tooltips"],
        "supportEnhancedTooltips": true
    },
    "supportsHighlight": false,
    "supportsEmptyDataView": true,
    "privileges": []
}
