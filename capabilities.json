    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": { "max": 1 },
                    "measure": { "max": 1 },
                    "tooltips": { "max": 0 }
                }
            ],
            "categorical": {
                "categories": {
                    "for": { "in": "category" },
                    "dataReductionAlgorithm": { "window": { "count": 30000 } }
                },
                "values": {
                    "select": [
                        { "for": { "in": "measure" } }
                    ]
                }
            }
        },
        {
            "conditions": [
                {
                    "category": { "max": 1 },
                    "measure": { "max": 1 },
                    "tooltips": { "min": 1 }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "category" } },
                        { "for": { "in": "measure" } },
                        { "for": { "in": "tooltips" } }
                    ],
                    "dataReductionAlgorithm": { "window": { "count": 30000 } }
                }
            }
        }
    ],
    "tooltips": {
        "supportedTypes": { "default": true, "canvas": true },
        "roles": ["tooltips"],
